---
import Authors from "../components/Authors.astro";
import WorkCard from "../components/WorkCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { linkOf, monthYear, news, profile, publications } from "../content";
import { refs } from "../content/refs";

const site = Astro.site!;
const resume = linkOf("resume");
const email = linkOf("email");
const scholar = linkOf("scholar");
const github = linkOf("github");
const sameAs = (["github", "linkedin", "scholar"] as const).flatMap((kind) => linkOf(kind)?.href ?? []);
const selected = publications.filter((p) => p.status !== "preprint").slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  dateModified: "2026-10-07",
  mainEntity: {
    "@type": "Person",
    name: profile.displayName,
    url: new URL("/", site).href,
    image: profile.photo ? new URL(profile.photo, site).href : undefined,
    jobTitle: profile.role,
    affiliation: { "@type": "CollegeOrUniversity", name: profile.affiliation },
    alumniOf: { "@type": "CollegeOrUniversity", name: "Khulna University of Engineering & Technology" },
    email: email?.href,
    sameAs,
    knowsAbout: ["High-performance networking", "Distributed systems", "Agentic AI systems", "Large language models"],
  },
};
---

<BaseLayout title={`${profile.displayName} · ${profile.role}, ${profile.affiliationShort}`} description={profile.description} home jsonLd={jsonLd}>
  <div class="wrap">
    <section class="hero" aria-label="Introduction">
      {profile.photo && <img src={profile.photo} width="480" height="480" alt={`Portrait of ${profile.displayName}`} fetchpriority="high" />}
      <div>
        <h1>{profile.displayName}</h1>
        <p class="lede">I build AI systems for high-performance networking where the model proposes and the system decides.</p>
        <p class="role">{profile.role}, <a href={refs.mst}>{profile.affiliationShort}</a> · <a href={refs.kummer}>Kummer Doctoral Fellow</a></p>
        <div class="actions">
          {resume && <a class="button solid" href={resume.href}>Résumé (PDF)</a>}
          {email && <a class="button" href={email.href}>Email</a>}
          {scholar && <a class="button" href={scholar.href} rel="me noreferrer">Google Scholar</a>}
          {github && <a class="button" href={github.href} rel="me noreferrer">GitHub</a>}
        </div>
      </div>
    </section>

    <div class="now" aria-label="Now">
      <div><span class="kicker">Next</span><a href={refs.works26}>WORKS26</a> at <a href={refs.sc26}>SC26</a> in Chicago, 15 November 2026</div>
      <div><span class="kicker">Released</span><a href="/research/netbench/">NetBench</a> v1.1.0, with a <a href={refs.netbenchDoi}>DOI on Zenodo</a></div>
      <div><span class="kicker">Seeking</span>{profile.availability.replace(/^Seeking /, "").replace(/^./, (c) => c.toUpperCase())}</div>
    </div>

    <section class="section" id="work" aria-labelledby="work-heading">
      <div class="section-head">
        <h2 id="work-heading">Selected work</h2>
        <a href="/about/">More about me →</a>
      </div>
      <p class="group-label">Research</p>
      <div class="cards">
        <WorkCard
          href="/research/netbench/"
          visual="netbench"
          tone="released"
          kicker="Released · v1.1.0"
          title="NetBench"
          text="A 242-question benchmark from 175 papers, and a controlled study of what fine-tuning, continued pre-training, and retrieval teach a language model about networking."
        />
        <WorkCard
          href="/research/guarded-orchestration/"
          visual="guarded"
          tone="accepted"
          kicker="Accepted · WORKS26 at SC26"
          title="Guarded orchestration"
          text="LLM function calling with workflow state, so scientists can run trained models in plain language and nothing runs until the inputs are complete."
        />
        <WorkCard
          href="/research/agentic-data-transfer-optimizer/"
          visual="optimizer"
          tone="progress"
          kicker="In progress"
          title="Agentic Data Transfer Optimizer"
          text="Two agents tune bulk-transfer concurrency from live TCP telemetry, while hard limits keep every action in bounds."
        />
      </div>
      <p class="group-label">Engineering</p>
      <div class="cards">
        <WorkCard
          href="/projects/kona-token-trade/"
          visual="kona"
          kicker="Industry · 2022–2025"
          title="Kona Token Trade"
          text="Owned 6 of the platform's 30 Spring Boot microservices and moved inter-service calls onto Kafka, so one unavailable service could no longer fail a trade."
        />
        <WorkCard
          href="/projects/card-personalization/"
          visual="card"
          kicker="Industry · Seoul to Dhaka"
          title="Card Personalization System"
          text="Learned Kona I's smart-card personalization system in Seoul and set it up end to end in Bangladesh."
        />
        <WorkCard
          href="/projects/loadlens/"
          visual="loadlens"
          kicker="Side project"
          title="LoadLens"
          text="A student workload planner where language models propose schedule changes and deterministic code checks every one."
        />
      </div>
    </section>

    <div class="split section">
      <section aria-labelledby="news-heading">
        <div class="section-head">
          <h2 id="news-heading">Recent</h2>
        </div>
        <ul class="list-rows">
          {
            news.slice(0, 4).map((item) => (
              <li>
                <time class="date" datetime={item.date}>
                  {monthYear(item.date)}
                </time>
                {item.text}
                {item.href && (
                  <>
                    {" "}
                    <a href={item.href}>{item.linkLabel}</a>
                  </>
                )}
              </li>
            ))
          }
        </ul>
      </section>
      <section aria-labelledby="pubs-heading">
        <div class="section-head">
          <h2 id="pubs-heading">Selected publications</h2>
          <a href="/publications/">All publications →</a>
        </div>
        <ul class="list-rows">
          {
            selected.map((p) => (
              <li>
                <a class="pub-title" href={`/publications/#${p.id}`}>
                  {p.title}
                </a>
                <Authors authors={p.authors} />
                <p class="venue">
                  {p.venue}, {p.year}
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
