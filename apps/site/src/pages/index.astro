---
import Authors from "../components/Authors.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  education,
  experience,
  highlights,
  linkOf,
  monthYear,
  news,
  profile,
  projects,
  publications,
  research,
  skillGroups,
} from "../content";

const site = Astro.site!;
const external = (href: string) => href.startsWith("https://");
const sideProjects = projects.filter((project) => project.id !== "kona-token-trade");
const honors = highlights.filter((item) => item.category === "honor");
const service = highlights.filter((item) => item.category === "service");
const statusLabel = { accepted: "Accepted", published: "Published", preprint: "Preprint" };
const sameAs = (["github", "linkedin", "scholar"] as const).flatMap((kind) => linkOf(kind)?.href ?? []);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  dateModified: "2026-10-05",
  mainEntity: {
    "@type": "Person",
    name: profile.displayName,
    url: new URL("/", site).href,
    image: profile.photo ? new URL(profile.photo, site).href : undefined,
    jobTitle: profile.role,
    affiliation: { "@type": "CollegeOrUniversity", name: profile.affiliation },
    alumniOf: { "@type": "CollegeOrUniversity", name: "Khulna University of Engineering & Technology" },
    email: linkOf("email")?.href,
    sameAs,
    knowsAbout: ["High-performance networking", "Distributed systems", "Agentic AI systems", "Large language models"],
  },
};
---

<BaseLayout title={`${profile.displayName} · ${profile.role}, ${profile.affiliationShort}`} description={profile.description} home jsonLd={jsonLd}>
  <section class="bio" aria-label="About">
    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="section" id="news" aria-labelledby="news-heading">
    <h2 id="news-heading">News</h2>
    <ul class="news">
      {
        news.map((item) => (
          <li>
            <time class="date" datetime={item.date}>
              {monthYear(item.date)}
            </time>
            <p>
              {item.text}
              {item.href && (
                <>
                  {" "}
                  <a href={item.href}>{item.linkLabel}</a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="research" aria-labelledby="research-heading">
    <h2 id="research-heading">Research</h2>
    <div class="entries">
      {
        research.map((item) => (
          <article class="entry">
            <h3>
              <a href={item.href}>{item.title}</a>
            </h3>
            <p class:list={["status", `tone-${item.tone}`]}>{item.status}</p>
            <p>{item.summary}</p>
            <ul class="stack" aria-label="Built with">
              {item.stack.map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
            <p class="links">
              <a href={item.href} aria-label={`Details: ${item.title}`}>
                Details
              </a>
              {item.links.map((link) => (
                <a href={link.href} aria-label={`${link.label}: ${item.title}`}>
                  {link.label} ↗
                </a>
              ))}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" id="publications" aria-labelledby="publications-heading">
    <h2 id="publications-heading">Publications</h2>
    <ol class="pubs">
      {
        publications.map((item) => (
          <li>
            <p class="pub-title">{item.title}</p>
            <Authors authors={item.authors} />
            <p class="venue">
              {item.venue}, {item.year} · {statusLabel[item.status]}
            </p>
            {item.note && <p class="pub-note">{item.note}</p>}
            {item.links.length > 0 && (
              <p class="links">
                {item.links.map((link) => (
                  <a href={link.href} aria-label={`${link.label}: ${item.title}`}>
                    {link.label}
                    {external(link.href) && " ↗"}
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ol>
    <p class="software">
      <strong>Software.</strong> N. H. Neom, R. M. Swargo, M. Arifuzzaman. <em>NetBench</em>, v1.1.0. Zenodo, 2026.{" "}
      <a href="https://doi.org/10.5281/zenodo.21892017">doi:10.5281/zenodo.21892017</a>
    </p>
  </section>

  <section class="section" id="experience" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <ol class="timeline">
      {
        experience.map((item) => (
          <li>
            <p class="date">
              {item.start} – {item.end}
            </p>
            <div>
              <h3>{item.role}</h3>
              <p class="org">
                {item.organization} · {item.location}
              </p>
              <p class="summary">{item.summary}</p>
              {item.bullets.length > 0 && (
                <ul class="bullets">
                  {item.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
              {item.href && (
                <p class="links">
                  <a href={item.href}>{item.hrefLabel}</a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <h3 class="subhead">Education</h3>
    <ol class="timeline">
      {
        education.map((item) => (
          <li>
            <p class="date">
              {item.start} – {item.end}
            </p>
            <div>
              <h3>{item.degree}</h3>
              <p class="org">{item.institution}</p>
              {item.details.length > 0 && <p class="summary">{item.details.join(" · ")}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" id="more" aria-labelledby="more-heading">
    <h2 id="more-heading">More</h2>
    <div class="more">
      <div>
        <h3>Skills</h3>
        <dl class="skills">
          {
            skillGroups.map((group) => (
              <div>
                <dt>{group.title}</dt>
                <dd>{group.items.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h3>Side project</h3>
        <ul class="plain-list">
          {
            sideProjects.map((project) => (
              <li>
                <a href={project.href}>{project.title}</a>. {project.summary}
              </li>
            ))
          }
        </ul>
        <h3 class="more-gap">Honors</h3>
        <ul class="plain-list">
          {
            honors.map((item) => (
              <li>
                {item.href ? <a href={item.href}>{item.title}</a> : item.title}
                {item.detail && <span class="detail">, {item.detail}</span>}
              </li>
            ))
          }
        </ul>
        <h3 class="more-gap">Service</h3>
        <ul class="plain-list">
          {
            service.map((item) => (
              <li>
                {item.title}
                {item.detail && <span class="detail">, {item.detail}</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
