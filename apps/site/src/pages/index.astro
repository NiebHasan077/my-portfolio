---
import { profile, publishedProjects, research } from "../content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import StatusStrip from "../components/StatusStrip.astro";

const featured = publishedProjects[0];
const optimizer = research.find((item) => item.publish && item.id === "agentic-data-transfer-optimizer");
---

<BaseLayout title="Nieb Hasan Neom · AI Systems Portfolio" description="Nieb Hasan Neom builds guarded AI systems for distributed infrastructure and networking, backed by research and production backend experience.">
  <section class="hero page-shell">
    <div class="hero-copy">
      <span class="eyebrow">NIEB HASAN NEOM / AI SYSTEMS</span>
      <h1>AI systems for <em>networks and distributed infrastructure.</em></h1>
      <p class="hero-role">{profile.headline}</p>
      <p class="hero-lede">{profile.summary}</p>
      <div class="hero-actions">
        <a class="button primary" href="/work">Explore selected work <span aria-hidden="true">→</span></a>
        <a class="button" href="/work/agentic-data-transfer-optimizer">View active research</a>
        <a class="button" href="/resume">View résumé</a>
      </div>
    </div>
    <div class="hero-instrument" aria-label="Portfolio evidence map">
      <div class="instrument-header"><span>PORTFOLIO / EVIDENCE-MAP</span><span class="live-dot">PUBLIC-SAFE</span></div>
      <div class="loop-diagram">
        <div class="loop-node active"><small>01</small><strong>Research</strong><span>clear questions</span></div>
        <div class="loop-link"><span>evaluate</span></div>
        <div class="loop-node"><small>02</small><strong>Systems</strong><span>backend practice</span></div>
        <div class="loop-link"><span>validate</span></div>
        <div class="loop-node accent"><small>03</small><strong>Evidence</strong><span>approved claims</span></div>
      </div>
      <div class="instrument-metrics">
        <span><small>FOCUS</small><strong>AI + NETWORKS</strong></span>
        <span><small>METHOD</small><strong>MEASURED</strong></span>
        <span><small>STATUS</small><strong>ACTIVE</strong></span>
      </div>
    </div>
  </section>

  <div class="page-shell"><StatusStrip /></div>

  <section class="proof-section page-shell">
    <div class="section-intro">
      <span class="eyebrow">THE ENGINEERING THESIS</span>
      <h2>Make AI behavior inspectable at the system boundary.</h2>
      <p>My work connects guarded model execution, adaptive data movement, and backend reliability. The evidence matters as much as the output.</p>
    </div>
    <div class="proof-grid">
      <article><span class="proof-number">01</span><h3>Define the question</h3><p>Explicit scope, evaluation criteria, and limitations before results.</p></article>
      <article><span class="proof-number">02</span><h3>Measure the system</h3><p>Controlled evaluations, reproducible methods, and results separated from unsupported claims.</p></article>
      <article><span class="proof-number">03</span><h3>Ground the claim</h3><p>Every public fact maps to reviewed evidence and an explicit approval state.</p></article>
    </div>
  </section>

  {featured && <section class="featured-work page-shell"><div class="section-label"><span>FEATURED RESEARCH CASE STUDY</span><span>ACCEPTED / 2026</span></div><ProjectCard project={featured} /></section>}

  {optimizer && <section class="research-band">
    <div class="page-shell research-band-inner">
      <div><span class="eyebrow">{optimizer.eyebrow}</span><h2>{optimizer.title}</h2></div>
      <div>
        <p>{optimizer.summary}</p>
        <p class="research-status"><span>{optimizer.workstreams[0].status}</span><span>{optimizer.workstreams[1].status}</span></p>
      </div>
      <a class="text-link" href={optimizer.href}>Inspect the active workstreams <span aria-hidden="true">↗</span></a>
    </div>
  </section>}
</BaseLayout>
