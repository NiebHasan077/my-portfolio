---
import { availableLinks, publications, publishedProjects, research } from "../content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ResearchCard from "../components/ResearchCard.astro";
const scholar = availableLinks.find((link) => link.kind === "scholar");
---

<BaseLayout title="Work & Research · Nieb Hasan Neom" description="Evidence-backed AI systems, backend engineering, high-performance networking research, and publications." active="Work">
  <header class="page-header page-shell">
    <span class="eyebrow">WORK & RESEARCH</span>
    <h1>Systems, with the seams left visible.</h1>
    <p>Completed case studies and active research are separated by status. Each entry names the contribution, evidence, boundary, and next unknown.</p>
  </header>
  <section class="work-list page-shell" aria-label="Selected projects">
    {publishedProjects.map((project) => <ProjectCard project={project} />)}
    {research.filter((item) => item.publish).map((item) => <ResearchCard research={item} />)}
  </section>
  <section class="publication-section page-shell">
    <div class="section-intro-row">
      <div class="section-intro"><span class="eyebrow">PUBLICATIONS</span><h2>Published, accepted, and preprint work—with status visible.</h2></div>
      {scholar && <a class="button compact" href={scholar.href} target="_blank" rel="noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>}
    </div>
    <div class="publication-list">
      {publications.filter((item) => item.publish).map((publication) => (
        publication.href ? (
          <a href={publication.href} target="_blank" rel="noreferrer">
            <span>{publication.year}</span>
            <div><h3>{publication.title}</h3><p><strong>{publication.status}</strong>{publication.venue}</p></div>
            <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <article>
            <span>{publication.year}</span>
            <div><h3>{publication.title}</h3><p><strong>{publication.status}</strong>{publication.venue}</p></div>
            <span aria-hidden="true">—</span>
          </article>
        )
      ))}
    </div>
  </section>
</BaseLayout>
