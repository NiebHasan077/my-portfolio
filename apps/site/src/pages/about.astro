---
import { availableLinks, profile, publishedHighlights, skillGroups } from "../content";
import BaseLayout from "../layouts/BaseLayout.astro";

const problemSolving = publishedHighlights.filter((item) => item.category === "problem-solving");
const leadership = publishedHighlights.filter((item) => item.category === "leadership");
---

<BaseLayout title="About · Nieb Hasan Neom" description="Nieb Hasan Neom's technical focus, engineering principles, problem-solving record, leadership, and contact links." active="About">
  <header class="page-header about-header page-shell">
    <span class="eyebrow">ABOUT / {profile.broadLocation}</span>
    <h1>AI becomes a systems problem the moment it meets infrastructure.</h1>
  </header>
  <section class="about-grid page-shell">
    <div class="about-copy">
      <p class="large-copy">{profile.about}</p>
      <p>I am a Computer Science PhD student and Kummer Doctoral Fellow at Missouri S&T, following three years of backend engineering at Kona Software Lab. I am interested in research roles where AI, distributed systems, networking, and careful software engineering meet.</p>
    </div>
    <aside class="principles-card">
      <span class="eyebrow">OPERATING PRINCIPLES</span>
      <ol><li><span>01</span>Make constraints executable.</li><li><span>02</span>Prefer evidence over adjectives.</li><li><span>03</span>Design fallback as a first-class path.</li><li><span>04</span>Separate correctness from performance claims.</li></ol>
    </aside>
  </section>
  <section class="skill-section page-shell">
    <div class="section-intro"><span class="eyebrow">TECHNICAL RANGE</span><h2>Tools grouped by the systems problems they support.</h2></div>
    <div class="skill-grid">
      {skillGroups.map((group) => (
        <article>
          <h3>{group.title}</h3>
          <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
  <section class="highlight-section page-shell">
    <div class="highlight-column">
      <span class="eyebrow">PROBLEM SOLVING</span>
      {problemSolving.map((item) => (
        <article>
          <h2>{item.title}</h2><p>{item.detail}</p>
          {item.href && <a class="text-link" href={item.href} target="_blank" rel="noreferrer">View profile <span aria-hidden="true">↗</span></a>}
        </article>
      ))}
    </div>
    <div class="highlight-column">
      <span class="eyebrow">LEADERSHIP & COMMUNITY</span>
      {leadership.map((item) => <article><h2>{item.title}</h2><p>{item.detail}</p></article>)}
    </div>
  </section>
  <section id="contact" class="contact-band page-shell">
    <div><span class="eyebrow">CONTACT</span><h2>Start with the systems question.</h2><p>Reach me directly by email or through the public profiles below. This site uses no contact form, cookies, or third-party tracking.</p></div>
    <div class="contact-links">
      {availableLinks.filter((link) => link.kind !== "resume").map((link) => <a class="button" href={link.href} target={link.kind === "email" ? undefined : "_blank"} rel={link.kind === "email" ? undefined : "noreferrer"}>{link.label} <span aria-hidden="true">↗</span></a>)}
    </div>
  </section>
</BaseLayout>
