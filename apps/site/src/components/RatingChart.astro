---
type Point = { date: string; rating: number; contest: string };
type Band = { from: number; to: number; fill: string; label: string; ink: string };
type Props = {
  title: string;
  points: Point[];
  yMin: number;
  yMax: number;
  yTicks: number[];
  bands?: Band[];
};

const { title, points, yMin, yMax, yTicks, bands = [] } = Astro.props;
const W = 720;
const H = 260;
const L = 46;
const R = 14;
const T = 14;
const B = 30;
const time = (date: string) => new Date(`${date}T12:00:00Z`).getTime();
const first = time(points[0]!.date);
const last = time(points.at(-1)!.date);
const pad = (last - first) * 0.03;
const t0 = first - pad;
const t1 = last + pad;
const X = (t: number) => L + ((t - t0) / (t1 - t0)) * (W - L - R);
const Y = (r: number) => T + (1 - (r - yMin) / (yMax - yMin)) * (H - T - B);
const xy = points.map((p) => [X(time(p.date)), Y(p.rating)] as const);
const line = "M" + xy.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" L");
const area = `M${xy[0]![0].toFixed(1)},${H - B} L` + xy.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" L") + ` L${xy.at(-1)![0].toFixed(1)},${H - B} Z`;
const peakIndex = points.reduce((best, p, i) => (p.rating > points[best]!.rating ? i : best), 0);
const peak = points[peakIndex]!;
const firstYear = new Date(first).getUTCFullYear() + 1;
const lastYear = new Date(last).getUTCFullYear();
const years = Array.from({ length: Math.max(0, lastYear - firstYear + 1) }, (_, i) => firstYear + i);
const month = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const readout = points.map((p, i) => [Number(xy[i]![0].toFixed(1)), Number(xy[i]![1].toFixed(1)), `${month(p.date)} · ${p.rating} · ${p.contest}`]);
const description = `${points.length} rated contests from ${month(points[0]!.date)} to ${month(points.at(-1)!.date)}, peaking at ${peak.rating} in ${month(peak.date)}; latest ${points.at(-1)!.rating}.`;
---

<figure class="chart" data-chart data-points={JSON.stringify(readout)}>
  <div class="svg-box">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}. ${description}`} tabindex="0">
      {
        bands.map((band) => (
          <g>
            <rect x={L} y={Y(band.to)} width={W - L - R} height={Y(band.from) - Y(band.to)} fill={band.fill} opacity="0.38" />
            <text x={W - R - 6} y={Y(band.to) + 13} text-anchor="end" class="band-label" fill={band.ink}>
              {band.label}
            </text>
          </g>
        ))
      }
      {
        yTicks.map((tick) => (
          <g>
            <line x1={L} x2={W - R} y1={Y(tick)} y2={Y(tick)} class="grid" />
            <text x={L - 8} y={Y(tick) + 3.5} text-anchor="end" class="axis">
              {tick}
            </text>
          </g>
        ))
      }
      {
        years.map((year) => {
          const x = X(Date.UTC(year, 0, 1));
          return (
            <g>
              <line x1={x} x2={x} y1={H - B} y2={H - B + 5} stroke="#9aa1a8" />
              <text x={x} y={H - 10} text-anchor="middle" class="axis">
                {year}
              </text>
            </g>
          );
        })
      }
      <path d={area} class="area"></path>
      <path d={line} class="line"></path>
      <circle cx={xy[peakIndex]![0]} cy={xy[peakIndex]![1]} r="5" class="peak"></circle>
      <text x={xy[peakIndex]![0] - 8} y={xy[peakIndex]![1] - 9} text-anchor="end" class="axis" fill="#2f4fb0">peak {peak.rating}</text>
      <circle cx="-20" cy="-20" r="4.5" class="hover-dot" data-dot></circle>
    </svg>
  </div>
  <figcaption class="chart-readout" data-readout aria-live="polite">{description}</figcaption>
</figure>

<script>
  for (const chart of document.querySelectorAll<HTMLElement>("[data-chart]")) {
    const points = JSON.parse(chart.dataset.points ?? "[]") as Array<[number, number, string]>;
    const svg = chart.querySelector("svg")!;
    const dot = chart.querySelector("[data-dot]")!;
    const readout = chart.querySelector<HTMLElement>("[data-readout]")!;
    let index = points.length - 1;
    const show = (i: number) => {
      index = Math.max(0, Math.min(points.length - 1, i));
      const [x, y, label] = points[index]!;
      dot.setAttribute("cx", String(x));
      dot.setAttribute("cy", String(y));
      readout.textContent = label;
    };
    const nearest = (clientX: number) => {
      const box = svg.getBoundingClientRect();
      const x = ((clientX - box.left) / box.width) * 720;
      let best = 0;
      points.forEach(([px], i) => {
        if (Math.abs(px - x) < Math.abs(points[best]![0] - x)) best = i;
      });
      return best;
    };
    svg.addEventListener("pointermove", (event) => show(nearest(event.clientX)));
    svg.addEventListener("pointerdown", (event) => show(nearest(event.clientX)));
    svg.addEventListener("keydown", (event) => {
      const step = { ArrowLeft: -1, ArrowRight: 1, Home: -points.length, End: points.length }[event.key];
      if (step === undefined) return;
      event.preventDefault();
      show(index + step);
    });
  }
</script>
