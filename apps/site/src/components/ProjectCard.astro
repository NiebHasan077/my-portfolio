---
import type { Project } from "../content";
const { project } = Astro.props as { project: Project };
---

<article class="project-card">
  <div class="project-card-top">
    <span class="eyebrow">{project.eyebrow}</span>
    <span class="schema-chip">CASE / {project.id.toUpperCase()}</span>
  </div>
  <h2>{project.title}</h2>
  <p class="project-summary">{project.summary}</p>
  <ul class="evidence-list">
    {project.details.map((detail) => <li>{detail}</li>)}
  </ul>
  <div class="project-footer">
    <div class="tech-list">{project.technologies.map((technology) => <span>{technology}</span>)}</div>
    <a class="text-link" href={project.href}>Inspect case study <span aria-hidden="true">↗</span></a>
  </div>
</article>
