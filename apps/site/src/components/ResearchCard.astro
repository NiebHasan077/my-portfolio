---
import type { Research } from "../content";
const { research } = Astro.props as { research: Research };
---

<article class="project-card research-card">
  <div class="project-card-top">
    <span class="eyebrow">{research.eyebrow}</span>
    <span class="schema-chip">{research.status}</span>
  </div>
  <h2>{research.title}</h2>
  <p class="project-summary">{research.summary}</p>
  <div class="workstream-grid">
    {research.workstreams.map((workstream, index) => (
      <section>
        <span>0{index + 1} / {workstream.status}</span>
        <h3>{workstream.title}</h3>
        <p>{workstream.summary}</p>
      </section>
    ))}
  </div>
  <div class="project-footer">
    <span class="evidence-boundary">No completion or effectiveness claim until reproducible evidence is approved.</span>
    <a class="text-link" href={research.href}>Inspect research scope <span aria-hidden="true">↗</span></a>
  </div>
</article>
