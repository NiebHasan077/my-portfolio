---
import scholar from "../data/scholar.json";

// Citations per year, drawn the way Google Scholar draws them: one bar a year,
// the count on top. The current year is still open, so its bar is lighter.
const W = 560;
const H = 212;
const L = 12;
const R = 12;
const T = 26;
const B = 42;
const years = scholar.years;
const max = Math.max(...years.map((y) => y.citations));
const slot = (W - L - R) / years.length;
const barW = slot * 0.56;
const Y = (v: number) => T + (1 - v / max) * (H - T - B);
const thisYear = Number(scholar.fetched.slice(0, 4));
const fetched = new Date(`${scholar.fetched}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const description = `Citations per year on Google Scholar: ${years.map((y) => `${y.year}, ${y.citations}${y.year === thisYear ? " so far" : ""}`).join("; ")}.`;
---

<figure class="figure citations">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={description}>
    <line x1={L} x2={W - R} y1={H - B} y2={H - B} class="baseline" />
    {
      years.map((y, i) => {
        const x = L + slot * i + (slot - barW) / 2;
        const open = y.year === thisYear;
        return (
          <g>
            <rect x={x} y={Y(y.citations)} width={barW} height={H - B - Y(y.citations)} rx="2" class:list={["bar", { open }]} />
            <text x={x + barW / 2} y={Y(y.citations) - 7} text-anchor="middle" class="value">
              {y.citations}
            </text>
            <text x={x + barW / 2} y={H - B + 18} text-anchor="middle" class="axis">
              {y.year}
            </text>
            {open && (
              <text x={x + barW / 2} y={H - B + 34} text-anchor="middle" class="axis">
                so far
              </text>
            )}
          </g>
        );
      })
    }
  </svg>
  <figcaption>
    Citations per year on <a href={scholar.source}>Google Scholar</a>, {scholar.total} in total as of {fetched}. Most cite the <a href="#bangla-sign-language-paper">Bangla sign-language paper</a>.
  </figcaption>
</figure>
