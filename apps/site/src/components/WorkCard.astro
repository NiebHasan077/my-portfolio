---
type Props = {
  href: string;
  title: string;
  text: string;
  kicker: string;
  tone?: "released" | "accepted" | "progress";
  visual: "netbench" | "guarded" | "optimizer" | "kona" | "card" | "loadlens";
};

const { href, title, text, kicker, tone, visual } = Astro.props;
---

<a class="card" href={href}>
  <div class:list={["card-vis", { photo: visual === "loadlens" }]} aria-hidden="true">
    {
      visual === "netbench" && (
        <svg viewBox="0 0 240 100">
          <g font-family="ui-monospace, Menlo, monospace">
            <text x="12" y="18" font-size="10" font-weight="600" fill="#15191e">HPN-QA</text>
            <text x="228" y="18" font-size="9" fill="#5a616c" text-anchor="end">242 questions · 175 papers</text>
            <clipPath id="nb-bar"><rect x="12" y="30" width="216" height="22" rx="4" /></clipPath>
            <g clip-path="url(#nb-bar)">
              <rect x="12" y="30" width="68.7" height="22" fill="#11704a" />
              <rect x="80.7" y="30" width="88.4" height="22" fill="#93560a" />
              <rect x="169.1" y="30" width="58.9" height="22" fill="#a3322c" />
            </g>
            <text x="46.4" y="45" font-size="9.5" fill="#fff" text-anchor="middle">77</text>
            <text x="124.9" y="45" font-size="9.5" fill="#fff" text-anchor="middle">99</text>
            <text x="198.5" y="45" font-size="9.5" fill="#fff" text-anchor="middle">66</text>
            <text x="46.4" y="66" font-size="8.5" fill="#11704a" text-anchor="middle">easy</text>
            <text x="124.9" y="66" font-size="8.5" fill="#93560a" text-anchor="middle">medium</text>
            <text x="198.5" y="66" font-size="8.5" fill="#a3322c" text-anchor="middle">hard</text>
            <text x="12" y="88" font-size="8.5" fill="#5a616c">difficulty measured by a 3-model ladder</text>
          </g>
        </svg>
      )
    }
    {
      visual === "guarded" && (
        <svg viewBox="0 0 240 100">
          <g font-family="ui-monospace, Menlo, monospace" font-size="10">
            <rect x="8" y="10" width="140" height="20" rx="5" fill="#fff" stroke="#11704a" />
            <text x="18" y="24" fill="#15191e">size_nm  40 ✓</text>
            <rect x="8" y="38" width="140" height="20" rx="5" fill="#fff" stroke="#11704a" />
            <text x="18" y="52" fill="#15191e">zeta_mV  +12 ✓</text>
            <rect x="8" y="66" width="140" height="20" rx="5" fill="#fff" stroke="#a3322c" stroke-dasharray="3 3" />
            <text x="18" y="80" fill="#a3322c">speed_g  missing</text>
            <rect x="160" y="36" width="72" height="24" rx="12" fill="#f7e9e7" />
            <text x="172" y="52" fill="#a3322c">BLOCKED</text>
          </g>
        </svg>
      )
    }
    {
      visual === "optimizer" && (
        <svg viewBox="0 0 240 100">
          <g font-family="ui-monospace, Menlo, monospace" font-size="9">
            <text x="12" y="16" fill="#5a616c">best fixed setting</text>
            <rect x="12" y="22" width="216" height="14" rx="3" fill="#c9c6bd" />
            <text x="12" y="54" fill="#15191e">agent, no prior tuning</text>
            <text x="222" y="54" fill="#93560a" font-weight="600" text-anchor="end">94–98%</text>
            <rect x="12" y="60" width="203" height="14" rx="3" fill="#93560a" />
            <rect x="215" y="60" width="8.6" height="14" fill="#93560a" opacity="0.4" />
            <path d="M228 18v60" stroke="#15191e" stroke-width="1.2" stroke-dasharray="3 2" />
            <text x="12" y="93" fill="#5a616c">share of the best throughput objective</text>
          </g>
        </svg>
      )
    }
    {
      visual === "kona" && (
        <svg viewBox="0 0 240 100">
          <g font-family="ui-monospace, Menlo, monospace" font-size="9">
            <text x="12" y="14" fill="#5a616c">30 Spring Boot microservices</text>
            {Array.from({ length: 30 }, (_, i) => (
              <circle cx={30 + (i % 10) * 20} cy={30 + Math.floor(i / 10) * 20} r="6.5" fill={i < 6 ? "#0f5e73" : "#fff"} stroke={i < 6 ? "#0f5e73" : "#9fb0b3"} stroke-width="1.2" />
            ))}
            <circle cx="16" cy="90" r="4.5" fill="#0f5e73" />
            <text x="26" y="93" fill="#15191e">6 owned, moved onto Kafka</text>
          </g>
        </svg>
      )
    }
    {
      visual === "card" && (
        <svg viewBox="0 0 240 100">
          <g font-family="ui-monospace, Menlo, monospace">
            <rect x="12" y="20" width="58" height="44" rx="6" fill="#fff" stroke="#b9c4c6" />
            <text x="41" y="35" font-size="8.5" fill="#15191e" text-anchor="middle">keys</text>
            <text x="41" y="47" font-size="8.5" fill="#15191e" text-anchor="middle">+ data</text>
            <text x="41" y="58" font-size="7.5" fill="#5a616c" text-anchor="middle">profile</text>
            <path d="M74 42h22" stroke="#0f5e73" stroke-width="2" />
            <path d="M93 37l6 5-6 5" fill="none" stroke="#0f5e73" stroke-width="2" />
            <rect x="104" y="8" width="124" height="66" rx="9" fill="#fff" stroke="#b9c4c6" />
            <rect x="118" y="24" width="26" height="20" rx="4" fill="#d9b562" />
            <path d="M118 31h26M118 37h26M127 24v20M135 24v20" stroke="#a88a3e" stroke-width="0.8" />
            <rect x="118" y="56" width="70" height="5" rx="2" fill="#c9c6bd" />
            <rect x="196" y="56" width="20" height="5" rx="2" fill="#c9c6bd" />
            <rect x="104" y="80" width="34" height="15" rx="7.5" fill="#e6eff0" stroke="#0f5e73" stroke-width="0.8" />
            <text x="121" y="91" font-size="8" fill="#0f5e73" text-anchor="middle">EMV</text>
            <rect x="143" y="80" width="85" height="15" rx="7.5" fill="#e6eff0" stroke="#0f5e73" stroke-width="0.8" />
            <text x="185.5" y="91" font-size="8" fill="#0f5e73" text-anchor="middle">GlobalPlatform</text>
          </g>
        </svg>
      )
    }
    {visual === "loadlens" && <img src="/img/loadlens-overview.jpg" alt="" width="1440" height="900" loading="lazy" decoding="async" />}
  </div>
  <div class="card-body">
    <p class:list={["kicker", tone && `tone-${tone}`]}>{kicker}</p>
    <h3>{title}</h3>
    <p>{text}</p>
    <span class="more">Read the case study →</span>
  </div>
</a>
