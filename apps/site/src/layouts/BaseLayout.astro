---
import "@fontsource/source-sans-3/latin-400.css";
import "@fontsource/source-sans-3/latin-400-italic.css";
import "@fontsource/source-sans-3/latin-600.css";
import "@fontsource/source-serif-4/latin-600.css";
import "../styles/global.css";
import { linkOf, links, profile } from "../content";

type Props = {
  title: string;
  description: string;
  /** Which nav entry this page belongs to. */
  current?: "Research" | "Publications" | "Experience" | "CV";
  /** Home page: the masthead name is the page's h1. */
  home?: boolean;
  /** Detail pages: on phones, show only the name and the navigation. */
  compact?: boolean;
  /** Structured data for search engines, serialized as JSON-LD. */
  jsonLd?: Record<string, unknown>;
};

const { title, description, current, home = false, compact = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.jpg", Astro.site);
const nav = [
  ["Research", "/#research"],
  ["Publications", "/#publications"],
  ["Experience", "/#experience"],
  ["CV", "/cv/"],
] as const;
const email = linkOf("email");
const external = (href: string) => href.startsWith("https://");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content={profile.displayName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={home ? "profile" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.displayName}, ${profile.role}, ${profile.affiliationShort}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class:list={{ compact }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame">
      <header class="masthead">
        {
          profile.photo && (
            <img class="portrait" src={profile.photo} width="480" height="480" alt="" decoding="async" fetchpriority={home ? "high" : "auto"} />
          )
        }
        <div>
          {
            home ? (
              <h1 class="name">{profile.displayName}</h1>
            ) : (
              <p class="name">
                <a href="/">{profile.displayName}</a>
              </p>
            )
          }
          <p class="role">
            {profile.role}<br />{profile.affiliationShort}
          </p>
        </div>
        <div class="masthead-extra">
          <p class="availability">{profile.availability}</p>
        </div>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              nav.map(([label, href]) => (
                <li>
                  <a href={href} aria-current={current === label && label === "CV" ? "page" : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <ul class="contact-links masthead-extra" aria-label="Contact and profiles">
          {
            links.map((link) => (
              <li>
                <a href={link.href} rel={external(link.href) ? "me noreferrer" : undefined}>
                  {link.kind === "email" ? "Email" : link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </header>
      <main id="main">
        <div class="content">
          <slot />
        </div>
        <footer class="site-footer">
          <p>
            {profile.displayName} · {profile.broadLocation}
            {email && <> · <a href={email.href}>{email.href.replace("mailto:", "")}</a></>}
          </p>
          <p>Updated October 2026</p>
        </footer>
      </main>
    </div>
  </body>
</html>
