---
import "@fontsource/source-sans-3/latin-400.css";
import "@fontsource/source-sans-3/latin-400-italic.css";
import "@fontsource/source-sans-3/latin-600.css";
import "@fontsource/source-serif-4/latin-600.css";
import "../styles/global.css";
import ReadingAids from "../components/ReadingAids.astro";
import { linkOf, links, profile } from "../content";

type Props = {
  title: string;
  description: string;
  /** Which menu entry this page belongs to. */
  current?: "Work" | "Publications" | "About" | "CV";
  /** Home page: the hero carries the name, so the header shows only the menu. */
  home?: boolean;
  /** Long pages: a reading-progress bar and an "On this page" rail. */
  reading?: boolean;
  /** Structured data for search engines, serialized as JSON-LD. */
  jsonLd?: Record<string, unknown>;
};

const { title, description, current, home = false, reading = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.jpg", Astro.site);
const nav = [
  ["Work", "/#work"],
  ["Publications", "/publications/"],
  ["About", "/about/"],
  ["CV", "/cv/"],
] as const;
const email = linkOf("email");
const external = (href: string) => href.startsWith("https://");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content={profile.displayName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.displayName}, ${profile.role}, ${profile.affiliationShort}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {reading && <div class="progress" data-progress aria-hidden="true"></div>}
    <header class:list={["site-header", { home }]}>
      <div class="wrap">
        {!home && <a class="wordmark" href="/">{profile.displayName}</a>}
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              nav.map(([label, href]) => (
                <li>
                  <a href={href} aria-current={current === label && label !== "Work" ? "page" : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          {profile.displayName} · {profile.broadLocation}
          {email && <> · <a href={email.href}>{email.href.replace("mailto:", "")}</a></>}
          <br />Updated October 2026
        </p>
        <ul aria-label="Profiles and résumé">
          {
            links
              .filter((link) => link.kind !== "email")
              .map((link) => (
                <li>
                  <a href={link.href} rel={external(link.href) ? "me noreferrer" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
    </footer>
    {reading && <ReadingAids />}
  </body>
</html>
